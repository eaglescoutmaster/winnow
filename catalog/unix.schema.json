{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Winnow catalog for Linux and macOS",
  "type": "object",
  "required": ["schemaVersion", "platform", "categories", "tags", "protected", "items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "platform": { "enum": ["linux", "macos"] },
    "testedOn": { "type": "array", "items": { "type": "string" } },
    "categories": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "protected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packages": { "$ref": "#/definitions/strings" },
        "units": { "$ref": "#/definitions/strings" },
        "labels": { "$ref": "#/definitions/strings" },
        "paths": { "$ref": "#/definitions/strings" },
        "domains": { "$ref": "#/definitions/strings" }
      }
    },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/item" } }
  },
  "definitions": {
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "item": {
      "type": "object",
      "required": ["id", "name", "category", "tier", "tags", "op", "target", "returnsAfterUpgrade", "notes", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string" },
        "tier": { "enum": ["safe", "moderate", "aggressive", "never-default"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "op": { "enum": ["package-remove", "systemd-disable", "gsettings-set", "keyvalue-set", "defaults-write", "app-trash", "launchctl-disable"] },
        "target": { "type": "object" },
        "value": { "type": ["string", "number", "boolean"] },
        "valueType": { "enum": ["bool", "int", "float", "string"] },
        "applies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "distros": { "$ref": "#/definitions/strings" },
            "minVersion": { "type": "string" },
            "maxVersion": { "type": "string" },
            "note": { "type": "string" }
          }
        },
        "returnsAfterUpgrade": { "enum": ["yes", "no", "sometimes", "unknown"] },
        "notes": { "type": "string" },
        "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^https://" } }
      },
      "allOf": [
        { "if": { "properties": { "op": { "const": "package-remove" } } },
          "then": { "properties": { "target": { "required": ["manager", "name"], "additionalProperties": false, "properties": {
            "manager": { "enum": ["apt", "dnf", "snap", "flatpak"] }, "name": { "type": "string", "minLength": 1 },
            "alsoRemoves": { "$ref": "#/definitions/strings" } } } } } },
        { "if": { "properties": { "op": { "const": "systemd-disable" } } },
          "then": { "properties": { "target": { "required": ["unit", "scope"], "additionalProperties": false, "properties": {
            "unit": { "type": "string", "minLength": 1 }, "scope": { "enum": ["system", "user"] }, "mask": { "type": "boolean" } } } } } },
        { "if": { "properties": { "op": { "const": "gsettings-set" } } },
          "then": { "required": ["value"], "properties": { "target": { "required": ["schema", "key"], "additionalProperties": false, "properties": {
            "schema": { "type": "string", "minLength": 1 }, "key": { "type": "string", "minLength": 1 } } } } } },
        { "if": { "properties": { "op": { "const": "keyvalue-set" } } },
          "then": { "required": ["value"], "properties": { "target": { "required": ["file", "key"], "additionalProperties": false, "properties": {
            "file": { "type": "string", "pattern": "^/etc/" }, "key": { "type": "string", "minLength": 1 }, "separator": { "type": "string" } } } } } },
        { "if": { "properties": { "op": { "const": "defaults-write" } } },
          "then": { "required": ["value", "valueType"], "properties": { "target": { "required": ["domain", "key"], "additionalProperties": false, "properties": {
            "domain": { "type": "string", "minLength": 1 }, "key": { "type": "string", "minLength": 1 },
            "currentHost": { "type": "boolean" }, "sudo": { "type": "boolean" },
            "restart": { "type": "array", "items": { "enum": ["cfprefsd", "Dock", "Finder", "SystemUIServer", "ControlCenter", "NotificationCenter"] } } } } } } },
        { "if": { "properties": { "op": { "const": "app-trash" } } },
          "then": { "properties": { "target": { "required": ["path"], "additionalProperties": false, "properties": {
            "path": { "type": "string", "pattern": "^/Applications/[^/]+\\.app$" }, "bundleId": { "type": ["string", "null"] }, "masId": { "type": ["string", "null"] } } } } } },
        { "if": { "properties": { "op": { "const": "launchctl-disable" } } },
          "then": { "properties": { "target": { "required": ["label", "domain"], "additionalProperties": false, "properties": {
            "label": { "type": "string", "minLength": 1 }, "domain": { "enum": ["user", "system"] }, "refuseOverSsh": { "type": "boolean" } } } } } }
      ]
    }
  }
}
